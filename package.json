{
  "name": "FAST",
  "version": "1.0.0",
  "description": "Generated by cds init",
  "repository": "<Add your repository here>",
  "license": "ISC",
  "dependencies": {
    "@sap/cds": "^4.5.1",
    "@sap/cds-odata-v2-adapter-proxy": "^1.5.4",
    "@sap/hana-client": "^2.7.21",
    "@sap/logging": "^6.0.2",
    "@sap/xsenv": "^3.1.0",
    "@sap/xssec": "^3.0.10",
    "compression": "^1.7.4",
    "dynamic-html-pdf": "^1.0.2",
    "express": "^4.17.1",
    "handlebars": "^4.7.6",
    "helmet": "^4.2.0",
    "html-pdf": "^2.2.0",
    "mysql": "^2.18.1",
    "passport": "^0.4.1",
    "ramda": "^0.27.0",
    "sap-cf-mailer": "0.0.3"
  },
  "engines": {
    "node": "^10 || ^12"
  },
  "scripts": {
    "setup": "npm install && npm run setup:ui",
    "setup:ui": "cd app && npm install",
    "deploy": "cds deploy db --to sqlite:db/sxtender.db",
    "deploy:hana": "cds deploy --to hana --vcap-file ./default-env.json",
    "build": "cds build/all --clean",
    "build:local": "rm -rf ./srv/node_modules && cds build/all --clean ",
    "build:xs-security": "cds compile srv/ --to xsuaa  > xs-security.json",
    "build:xsa": "mbt build -p=xsa --mtar=FASTCAP-Backend.mtar",
    "build:cf": "mbt build -p=cf --mtar=FASTCAP-Backend-CF.mtar",
    "deploy:cf": "cf deploy mta_archives/FASTCAP-Backend-CF.mtar -e cf.mtaext",
    "debug": "node --inspect node_modules/@sap/cds/bin/cds.js run",
    "start:cds": "cds run",
    "start": "cds -v && node ./srv/index-local.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "uaa": {
        "kind": "xsuaa"
      }
    },
    "odata": {
      "version": "v4"
    }
  },
  "files": [
    "db",
    "srv"
  ],
  "devDependencies": {
    "@sap/cds-dk": "~3.4.0",
    "mbt": "~1.0.17"
  }
}
