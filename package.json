  "dependencies": {
    "@sap/cds": "^4.4.6",
    "@sap/cds-odata-v2-adapter-proxy": "^1.4.60",
    "@sap/hana-client": "^2.6.64",
    "@sap/logging": "^6.0.1",
    "@sap/xsenv": "^3.1.0",
    "@sap/xssec": "^3.0.10",
    "compression": "^1.7.4",
    "express": "^4.17.1",
    "handlebars": "^4.7.6",
    "helmet": "^4.2.0",
    "html-pdf": "^2.2.0",
    "mysql": "^2.18.1",
    "passport": "^0.4.1",
    "passport-http": "^0.3.0",
    "ramda": "^0.27.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^3.3.3",
    "mbt": "^1.0.12",
    "sqlite3": "^4.2.0"
  },
  "engines": {
    "node": "^12"
  },
  "scripts": {
    "setup": "npm install && npm run setup:ui",
    "setup:ui": "cd app && npm install",
    "deploy": "cds deploy db --to sqlite:db/sxtender.db",
    "build": "cds build/all --clean",
    "build:xs-security": "cds compile srv/ --to xsuaa  > xs-security.json",
    "build:xsa": "mbt build -p=xsa --mtar=FASTCAP-Backend.mtar",
    "build:cf": "mbt build -p=cf --mtar=FASTCAP-Backend-CF.mtar",
    "deploy:cf": "cf deploy mta_archives/FASTCAP-Backend-CF.mtar -e cf.mtaext",
    "debug": "node --inspect node_modules/@sap/cds/bin/cds.js run",
    "start-cds": "cds run",
    "start": "node ./srv/index-local.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      }
    },
    "odata": {
      "version": "v4"
    }
  },
  "files": [
    "db",
    "srv"
  ]
}
