{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout"
  },
  "routes": [
    {
      "source": "/ODataDev/(.*)$",
      "target": "/ODataDev/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/reporting/(.*)$",
      "target": "/FAST/$1",
      "authenticationType": "basic",
      "destination": "srv_api",
      "csrfProtection": true
    },
    {
      "source": "/FAST/(.*)$",
      "target": "/FAST/$1",
      "authenticationType": "xsuaa",
      "destination": "srv_api",
      "csrfProtection": true
    }
  ]
}