#Create template entry (needed before you can upload)
POST http://localhost:4004/v2/tender/MailTemplateFiles
Authorization: Basic YXJ0aW9t
Content-Type: application/json

{
    "templateId":"PriceAgreementExpiredSoonMail",
    "title":"Price Agreement/s Expiring Soon!!",
    "filename" : "PriceAgreementExpiredSoonMail.html",
    "mediaType": "text/html"
}

### upload word template
PUT http://localhost:4004/v2/tender/MailTemplateFiles(templateId='PriceAgreementExpiredSoonMail')/content
Authorization: Basic YXJ0aW9t
Content-Type: text/html

< ../mail/PriceAgreementExpiredSoonMail.html

### create mapping between countrycode and template (for reusability)
POST http://localhost:4004/v2/tender/MailTemplates
Authorization: Basic YXJ0aW9t
Content-Type: application/json

{
    "CountryCode":"ES",
    "Language":"ES",
    "TemplateId":"PriceAgreementExpiredSoonMail"
}

### upload word template
POST http://localhost:4004/v2/tender/MailTemplateFiles
Authorization: Basic YXJ0aW9t
Content-Type: application/json

{
    "templateId":"PriceAgreementReminderMail",
    "title":"Reminder!!!Price Agreements Expiring Soon!!",
    "filename" : "PriceAgreementReminderMail.html",
    "mediaType": "text/html"
}

### upload word template
PUT http://localhost:4004/v2/tender/MailTemplateFiles(templateId='PriceAgreementReminderMail')/content
Authorization: Basic YXJ0aW9t
Content-Type: text/html

< ../mail/PriceAgreementReminderMail.html

### create mapping between countrycode and template (for reusability)
POST http://localhost:4004/v2/tender/MailTemplates
Authorization: Basic YXJ0aW9t
Content-Type: application/json

{
    "CountryCode":"ES",
    "Language":"ES",
    "TemplateId":"PriceAgreementReminderMail"
}
### get list of templates
GET http://localhost:4004/v2/tender/MailTemplateFiles
Authorization: Basic YXJ0aW9t

### get list of mappings between country and templates
GET http://localhost:4004/v2/tender/MailTemplates
Authorization: Basic YXJ0aW9t

### get templates by countrycode
GET http://localhost:4004/v2/tender/MailTemplates?$expand=MailTemplateFiles&$filter=countryCode%20eq%20%27ES%27
Authorization: Basic YXJ0aW9t

### download template - paste it in the browser
GET http://localhost:4004/v2/tender/MailTemplateFiles(templateId='PriceAgreementExpiredSoonMail')/content
Authorization: Basic YXJ0aW9t

### download filled template with offer data - paste it in the browser
# GET http://localhost:4004/v2/tender/WordAttachments(templateId=1,offerId='AE-16-100-1049-BPH-11')/content
# Authorization: Basic YXJ0aW9t

### delete mapping between countrycode and template
DELETE http://localhost:4004/v2/tender/MailTemplates(Language='ES',CountryCode='ES',TemplateId='PriceAgreementExpiredSoonMail')
Authorization: Basic YXJ0aW9t
### delete template
DELETE http://localhost:4004/v2/tender/MailTemplateFiles(templateId='PriceAgreementExpiredSoonMail')
Authorization: Basic YXJ0aW9t
### delete template
DELETE http://localhost:4004/v2/tender/MailTemplates(Language='ES',CountryCode='ES',TemplateId='PriceAgreementReminderMail')
Authorization: Basic YXJ0aW9t
### delete template
DELETE http://localhost:4004/v2/tender/MailTemplateFiles(templateId='PriceAgreementReminderMail')
Authorization: Basic YXJ0aW9t