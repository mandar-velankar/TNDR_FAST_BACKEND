#Create template entry (needed before you can upload)
POST http://localhost:4004/v2/tender/WordTemplate
Authorization: Basic YXJ0aW9t
Content-Type: application/json

{
    "templateId":5,
    "name":"Demo template advanced 2",
    "filename" : "word-template.docx",
    "mediaType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
}

### upload word template
PUT http://localhost:4004/v2/tender/WordTemplate(templateId=5)/content
Authorization: Basic YXJ0aW9t
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./word-template.docx

### create mapping between countrycode and template (for reusability)
POST http://localhost:4004/v2/tender/WordTemplateCountry
Authorization: Basic YXJ0aW9t
Content-Type: application/json

{
    "countryCode":"AR",
    "templateId":5
}
### get list of templates
GET http://localhost:4004/v2/tender/WordTemplate
Authorization: Basic YXJ0aW9t

### get list of mappings between country and templates
GET http://localhost:4004/v2/tender/WordTemplateCountry
Authorization: Basic YXJ0aW9t

### get templates by countrycode
GET http://localhost:4004/v2/tender/WordTemplateCountry?$expand=WordTemplates&$filter=countryCode%20eq%20%27IT%27
Authorization: Basic YXJ0aW9t

### download template - paste it in the browser
GET http://localhost:4004/v2/tender/WordTemplate(templateId=1)/content
Authorization: Basic YXJ0aW9t

### download filled template with offer data - paste it in the browser
GET http://localhost:4004/v2/tender/WordAttachments(templateId=1,offerId='AE-16-100-1049-BPH-11')/content
Authorization: Basic YXJ0aW9t

### delete mapping between countrycode and template
DELETE http://localhost:4004/v2/tender/WordTemplateCountry(templateId=1,countryCode='IT')
Authorization: Basic YXJ0aW9t
### delete template
DELETE http://localhost:4004/v2/tender/WordTemplate(templateId=3)
Authorization: Basic YXJ0aW9t