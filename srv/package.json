{
    "name": "FAST-srv",
    "description": "Generated from ../package.json, do not change!",
    "version": "1.0.0",
    "dependencies": {
        "@sap/cds": "4.3.1",
        "@sap/cds-odata-v2-adapter-proxy": "^1.4.60",
        "@sap/hana-client": "^2.4.196",
        "@sap/xsenv": "^3.1.0",
        "@sap/xssec": "^3.0.10",
        "express": "^4.17.1",
        "handlebars": "^4.7.6",
        "compression": "^1.7.4",
        "dynamic-html-pdf": "^1.0.2",
        "helmet": "^3.22.0",
        "html-pdf": "^2.2.0",
        "passport": "^0.4.1",
        "ramda": "^0.27.0"
    },
    "engines": {
        "node": "^10",
        "npm": "^6"
    },
    "devDependencies": {},
    "scripts": {
        "postinstall": "npm dedupe && node .build.js",
        "start-cds": "node ./node_modules/@sap/cds/bin/cds.js serve gen/csn.json",
        "start": "node ./index.js",
        "watch": "nodemon -w . -i node_modules/**,.git/** -e cds -x npm run build"
    },
    "private": true,
    "cds": {
        "requires": {
            "db": {
                "kind": "hana",
                "model": "gen/csn.json"
            },
            "uaa": {
                "kind": "xsuaa"
            }
        },
        "auth": {
            "passport": {
                "strategy": "JWT"
            }
        }
    }
}
