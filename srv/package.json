{
  "name": "FAST-srv",
  "description": "Generated from ../package.json, do not change!",
  "version": "1.0.0",
  "dependencies": {
    "@sap-cloud-sdk/core": "^1.54.2",
    "@sap-cloud-sdk/http-client": "^3.9.0",
    "@sap/cds": "6.3.0",
    "@sap/cds-odata-v2-adapter-proxy": "1.9.13",
    "compression": "1.7.4",
    "@sap/hana-client": "2.14.22",
    "@sap/logging": "^6.1.1",
    "@sap/xsenv": "^3.4.0",
    "@sap/xssec": "^3.6.0",
    "angular-expressions": "^1.1.4",
    "axios": "^0.21.1",
    "cfenv": "^1.2.4",
    "cron": "^1.8.2",
    "cron-es6": "^1.0.3",
    "cron-job-manager": "^2.2.1",
    "data-to-json": "^1.0.5",
    "dynamic-html-pdf": "^1.0.2",
    "easy-template-x": "^2.1.0",
    "export-to-csv": "^1.2.1",
    "express": "^4.17.1",
    "handlebars": "^4.7.6",
    "helmet": "^4.2.0",
    "html-pdf": "^2.2.0",
    "lodash.get": "^4.4.2",
    "mysql": "^2.18.1",
    "n2words": "1.15.0",
    "passport": "^0.4.1",
    "piscina": "^3.2.0",
    "qs": "^6.10.1",
    "ramda": "^0.27.0",
    "sap-cf-mailer": "0.0.3",
    "stream-to-blob": "^2.0.1",
    "uuid": "^8.3.2",
    "xlsx": "^0.18.5",
    "xlsx-template": "^1.3.0"
  },
  "engines": {
    "node": "^18.17"
  },
  "scripts": {
    "start": "cds -v && node ./index.js",
    "watch": "nodemon -w . -i node_modules/**,.git/** -e cds -x npm run build"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana",
        "model": "gen/srv/csn.json",
        "pool": {
          "max": 1400,
          "min": 100,
          "acquireTimeoutMillis": 5000
        }
      },
      "uaa": {
        "kind": "xsuaa"
      },
      "UITemplates": {
        "kind": "odata",
        "model": "gen/srv/csn.json",
        "credentials": {
          "destination": "fast-templates-api",
          "path": "/UITemplates"
        }
      },
      "ConditionContract": {
        "kind": "odata",
        "model": "gen/srv/csn.json",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "fast-ccma-api",
          "path": "/odata/v4/condition-contract"
        }
      }
    },
    "features": {
      "assert_integrity": false
    },
    "auth": {
      "passport": {
        "strategy": "JWT"
      }
    },
    "query": {
      "limit": {
        "default": 5000,
        "max": 5000
      }
    }
  }
}
