    "engines": {
        "node": "^14"
    },
    "scripts": {
        "start": "node ./index.js",
        "watch": "nodemon -w . -i node_modules/**,.git/** -e cds -x npm run build"
    },
    "private": true,
    "cds": {
        "requires": {
            "db": {
                "kind": "hana",
                "model": "gen/csn.json",
                "pool": {
                    "max": 1400,
                    "min": 100,
                    "acquireTimeoutMillis": 5000
                }
            },
            "uaa": {
                "kind": "xsuaa"
            }
        },
        "auth": {
            "passport": {
                "strategy": "JWT"
            }
        },
        "query": {
            "limit": {
                "default": 5000,
                "max": 5000
            }
        }
    }
