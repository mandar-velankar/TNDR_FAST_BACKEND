namespace com.bayer.SXTENDER.IntegrationData;

using { User, Country, cuid, managed } from '@sap/cds/common';
using { com.bayer.SXTENDER.IntegrationData } from './IntegrationData';

entity PublicMarketTenders as select from IntegrationData.MercadoPublicoLicitacione as tender {
    tender.CodigoExterno                    as ExternalCode,
    tender.Nombre                           as Name,
    tender.CodigoEstado                     as StateCode,
    tender.Descripcion                      as Description,
    tender.Estado                           as Condition,
    tender.DiasCierreLicitacion             as BidClosingDays,
    tender.Informada                        as Notified,
    tender.CodigoTipo                       as CodeType,
    tender.Tipo                             as TenderType,
    tender.TipoConvocatoria                 as CallType,
    tender.Moneda                           as Currency,
    tender.Etapas                           as Stages,
    tender.EstadoEtapas                     as StateSteps,
    tender.TomaRazon                        as Reason,
    tender.EstadoPublicidadOfertas          as Status,
    tender.JustificacionPublicidad          as JustificationAdvertising,
    tender.Contrato                         as Contract,
    tender.Obras                            as Works,
    tender.CantidadReclamos                 as ClaimsAmount,
    tender.FechaCreacion                    as CreatedAt,
    tender.FechaCierre                      as ClosingDate,
    tender.FechaInicio                      as StartDate,
    tender.FechaFinal                       as FinalDate,
    tender.FechaPubRespuestas               as DatePubAnswers,
    tender.FechaActoAperturaTecnica         as TechnicalOpeningActDate,
    tender.FechaActoAperturaEconomica       as EconomicOpeningActDate,
    tender.FechaPublicacion                 as PublicationDate,
    tender.FechaAdjudicacion                as AwardDate,
    tender.FechaEstimadaAdjudicacion        as EstimatedAwardDate,
    tender.FechaSoporteFisico               as PhysicalSupportDate,
    tender.FechaTiempoEvaluacion            as DateTimeEvaluation,
    tender.FechaEstimadaFirma               as EstimatedSignatureDate,
    tender.FechasUsuario                    as UserDate,
    tender.FechaVisitaTerreno               as FieldVisitTab,
    tender.FechaEntregaAntecedentes         as DeliveryBackgroundDate,
    tender.UnidadTiempoEvaluacion           as UnitEvaluationTime,
    tender.DireccionVisita                  as VisitAddress,
    tender.DireccionEntrega                 as DeliveryAddress,
    tender.Estimacion                       as Estimate,
    tender.FuenteFinanciamiento             as FinancingSource,
    tender.VisibilidadMonto                 as VisibilityAmount,
    tender.MontoEstimado                    as EstimatedAmount,
    tender.Tiempo                           as TenderTime,
    tender.UnidadTiempo                     as UnitTime,
    tender.Modalidad                        as Modality,
    tender.TipoPago                         as PaymentType,
    tender.NombreResponsablePago            as ResponsiblePaymentName,
    tender.EmailResponsablePago             as ResponsiblePaymentEmail,
    tender.NombreResponsableContrato        as ResponsibleContractName,
    tender.EmailResponsableContrato         as ResponsibleContractEmail,
    tender.FonoResponsableContrato          as ResponsibleContractPhone,
    tender.ProhibicionContratacion          as ContractingProhibition,
    tender.SubContratacion                  as Outsourcing,
    tender.UnidadTiempoDuracionContrato     as UnitTimeContractDuration,
    tender.TiempoDuracionContrato           as ContractDurationTime,
    tender.TipoDuracionContrato             as ContractDurationType,
    tender.JustificacionMontoEstimado       as EstimatedJustificationAmount,
    tender.ObservacionContract              as ContractObservation,
    tender.ExtensionPlazo                   as TermExtension,
    tender.EsBaseTipo                       as IsBaseType,
    tender.UnidadTiempoContratoLicitacion   as TenderContractUnitTime,
    tender.ValorTiempoRenovacion            as RenewalTimeValue,
    tender.PeriodoTiempoRenovacion          as RenewalTimePeriod,
    tender.EsRenovable                      as IsRenewable,
    tender.AdjudicacionTipo                 as AwardType,
    tender.AdjudicacionNumero               as AwardNumber,
    tender.AdjudicacionNumeroOferentes      as AwardNumberOfBidders,
    tender.AdjudicacionUrlActa              as AwardMinutesURL,
    tender.Comprador                        as Buyers,
    tender.Items                            as TenderItems
};

entity PublicMarketBuyers as select from IntegrationData.MercadoPublicoComprador as buyer {
    buyer.CodigoOrganismo                   as OrganismCode,
    buyer.NombreOrganismo                   as OrganismNumber,
    buyer.RutUnidad                         as UnitID,
    buyer.CodigoUnidad                      as UnitCode,
    buyer.NombreUnidad                      as UnitName,
    buyer.DireccionUnidad                   as UnitAddress,
    buyer.ComunaUnidad                      as UnitCommunity,
    buyer.RegionUnidad                      as UnitRegion,
    buyer.RutUsuario                        as UserID,
    buyer.CodigoUsuario                     as UserCode,
    buyer.NombreUsuario                     as UserNumber,
    buyer.CargoUsuario                      as UserTitle
};

entity PublicMarketProducts as select from IntegrationData.MercadoPublicoProducto as product {
    product.Correlativo                     as Correlative,
    product.CodigoProducto                  as ProductCode,
    product.CodigoCategoria                 as CategoryCode,
    product.Categoria                       as Category,
    product.NombreProducto                  as ProductNumber,
    product.Descripcion                     as Description,
    product.UnidadMedida                    as UoM,
    product.Cantidad                        as Quantity,
    product.AdjudicacionRutProveedor        as SupplierAwardID,
    product.AdjudicacionNombreProveedor     as SupplierAwardName,
    product.AdjudicacionCantidad            as AwardAmount,
    product.AdjudicacionMontoUnitario       as AwardCurrency,
    product.Licitacione                     as Tenders
};